# ============================================================
# ZelixPay - Environment Variables
# ============================================================

# Server
PORT=4000
# Base de zelixpay (Order/OrderItem/Payment/PaymentAttempt/etc).
DATABASE_URL="postgresql://postgres.[project-ref]:[password]@aws-1-sa-east-1.pooler.supabase.com:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres:[password]@db.[project-ref].supabase.co:5432/postgres"
# Base de Zelix (perfiles.pyme_context) — solo lectura, para el catálogo.
# Si ambos proyectos comparten la misma base Supabase, puede ser igual a DATABASE_URL.
ZELIX_DATABASE_URL="postgresql://postgres.[project-ref]:[password]@aws-1-sa-east-1.pooler.supabase.com:6543/postgres?pgbouncer=true"

# APP_URL = base del PROPIO servicio (callbacks/webhooks de la pasarela llegan
# directo aquí, sin pasar por zelix.cl). En Render: https://<servicio>.onrender.com
APP_URL=http://localhost:4000
# Base que usa el frontend para llamar a la API (`${base}/api/...`).
# Producción (detrás del proxy www.zelix.cl/catalogo/pay): /catalogo/pay
#   → la llamada queda /catalogo/pay/api/... y el proxy la lleva a este server.
# Dev (vite :3003 + api :4000): http://localhost:4000
VITE_API_BASE_URL=http://localhost:4000
# URL pública del carrito — para el redirect de vuelta tras el pago.
CLIENT_PORTAL_BASE_URL=http://localhost:3003/catalogo/pay

LOG_LEVEL=info
ENV_VALIDATION_MODE=warn

# ============================================================
# Payment Providers
# ============================================================
# Modos: sandbox = pruebas | production = cobros reales
PAYMENT_ENVIRONMENT=sandbox
PAYMENT_DEFAULT_PROVIDER=simulator
VITE_PAYMENT_PROVIDER=simulator

# --- Flow (dormido hasta tener las credenciales reales) ---
FLOW_API_KEY=change_me_flow_api_key
FLOW_SECRET_KEY=change_me_flow_secret_key

# Simulador interno. Activo en sandbox por defecto — así el carrito completo
# (catálogo -> orden -> "pago" -> confirmación) funciona sin Flow real.
SIMULATOR_ENABLED=true
SIMULATOR_DELAY_MS=300

# Demo en producción SIN pasarela real: fuerza pagos simulados (no Flow).
PAYMENT_SIMULATOR_DEMO=false
# Opt-in explícito para permitir PAYMENT_SIMULATOR_DEMO=true en producción.
ALLOW_DEMO_IN_PROD=false

# ============================================================
# Blindaje (obligatorio en PAYMENT_ENVIRONMENT=production)
# ============================================================
# Secreto de los webhooks internos (payment-provider genérico y payment-reversal)
# y del /api/health detallado. Mínimo 32 caracteres.
# Generar con: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ZELIXPAY_WEBHOOK_SECRET=change_me_webhook_secret
# Secreto del cron del outbox.
CRON_SECRET=change_me_cron_secret
# Orígenes autorizados a llamar la API desde un navegador (coma separada).
CORS_ALLOWED_ORIGINS=https://www.zelix.cl,https://zelix.cl
# Saltos de proxy confiables para resolver la IP real (zelix.cl → este server).
TRUST_PROXY_HOPS=1

# --- Antifraude / card testing (fraudGuard). 0 = desactiva ese límite ---
# Órdenes por IP en 10 minutos / en 1 hora.
FRAUD_ORDERS_PER_IP_10MIN=5
FRAUD_ORDERS_PER_IP_HOUR=12
# Comercios distintos que una misma IP puede tocar en 1 hora (barrido).
FRAUD_PYMES_PER_IP_HOUR=3
# Intentos rechazados por IP en 1 hora antes de cerrar la puerta (card testing).
FRAUD_REJECTED_PER_IP_HOUR=3
# Órdenes por mismo correo/teléfono en 1 hora.
FRAUD_ORDERS_PER_CONTACT_HOUR=6
# Topes de monto (CLP).
FRAUD_MAX_ORDER_AMOUNT_CLP=2000000
FRAUD_MAX_AMOUNT_PER_IP_DAY_CLP=3000000

# ============================================================
# Switch a PRODUCCION (activar Flow real)
# ============================================================
# PAYMENT_ENVIRONMENT=production
# PAYMENT_DEFAULT_PROVIDER=flow
# VITE_PAYMENT_PROVIDER=flow
# FLOW_API_KEY=<flow_api_key_real>
# FLOW_SECRET_KEY=<flow_secret_key_real>
# APP_URL=https://<host publico https>   # Flow exige urlConfirmation público
# ZELIXPAY_WEBHOOK_SECRET=<32+ chars>
# CRON_SECRET=<32+ chars>
